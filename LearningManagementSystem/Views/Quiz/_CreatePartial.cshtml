

<link href="~/assets/custom/select2/css/select2.min.css" rel="stylesheet" />
<div class="card-body">
    @using (Html.BeginForm("Create", "Quiz", FormMethod.Post, new { id = "CreateForm" }))
    {
        <div class="row">
            <div class="col-md-10">
                <div class="form-group">
                    <label for="TrainingQuiz_ModuleId">Course Module</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                    <br />
                    <select id="TrainingQuiz_ModuleId" name="TrainingQuiz_ModuleId" class="form-control" asp-items="ViewBag.TrainingQuiz_ModuleId">
                        <option value="">-- Select --</option>
                    </select>
                    <span id="error-message-module"></span>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label for="TrainingQuiz_EName">Quiz English Name</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                    <input type="text" class="form-control" id="TrainingQuiz_EName" name="TrainingQuiz_EName" placeholder="Enter English Name" autocomplete="off">
                    <span id="error-message-EName"></span>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label for="TrainingQuiz_SName">Quiz Sinhala Name</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                    <input type="text" class="form-control" id="TrainingQuiz_SName" name="TrainingQuiz_SName" placeholder="Enter Sinhala Name" autocomplete="off">
                    <span id="error-message-SName"></span>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label for="TrainingQuiz_TName">Quiz Tamil Name</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                    <input type="text" class="form-control" id="TrainingQuiz_TName" name="TrainingQuiz_TName" placeholder="Enter Tamil Name" autocomplete="off">
                    <span id="error-message-TName"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="TrainingQuiz_NoOfAnswerRequired">Number of required Answers</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                    <input type="number" class="form-control" id="TrainingQuiz_NoOfAnswerRequired" name="TrainingQuiz_NoOfAnswerRequired" placeholder="Enter Required Question Count" autocomplete="off">
                    <span id="error-message-NoReq"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="TrainingQuiz_AttemptCount">Number of required Answers</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                    <input type="number" class="form-control" id="TrainingQuiz_AttemptCount" name="TrainingQuiz_AttemptCount" placeholder="Enter Attempt Count" autocomplete="off">
                    <span id="error-message-Attemt"></span>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-2 form-actions">
                <button type="Reset" class="btn btn-warning round mr-1 mb-1">Clear</button>
            </div>
            <div class="col-md-3 form-actions" style="margin-left:-70px">
                <button type="button" class="btn btn-success round mr-1 mb-1" id="save">Success</button>
            </div>
        </div>
    }
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/assets/custom/datatable/js/jquery-3.3.1.js"></script>
<script src="~/assets/custom/select2/js/select2.full.min.js"></script>

<script type="text/javascript">
    $("#TrainingQuiz_ModuleId").select2({
        allowClear: true,
        placeholder: 'Select Module',
    });

    $('#save').on('click', function () {
        var form = $('#CreateForm');
        const errorMessageModuleContainer = document.getElementById('error-message-module');
        const errorMessageENameContainer = document.getElementById('error-message-EName');
        const errorMessageSNameContainer = document.getElementById('error-message-SName');
        const errorMessageTNameContainer = document.getElementById('error-message-TName');
        const errorMessageNoReqContainer = document.getElementById('error-message-NoReq');
        const errorMessageAttContainer = document.getElementById('error-message-Attemt');
        var TrainingQuiz_ModuleId = document.getElementById("TrainingQuiz_ModuleId").value;
        var TrainingQuiz_EName = document.getElementById("TrainingQuiz_EName").value;
        var TrainingQuiz_SName = document.getElementById("TrainingQuiz_SName").value;
        var TrainingQuiz_TName = document.getElementById("TrainingQuiz_TName").value;
        var TrainingQuiz_NoOfAnswerRequired = document.getElementById("TrainingQuiz_NoOfAnswerRequired").value;
        var TrainingQuiz_AttemptCount = document.getElementById("TrainingQuiz_AttemptCount").value;

        let isValid = true;
        errorMessageModuleContainer.textContent = '';
        errorMessageENameContainer.textContent = '';
        errorMessageSNameContainer.textContent = '';
        errorMessageTNameContainer.textContent = '';
        errorMessageNoReqContainer.textContent = '';
        errorMessageAttContainer.textContent = '';
        // --- User Name Validation ---
        if (TrainingQuiz_ModuleId == "") {
            errorMessageModuleContainer.textContent = 'Please Select Module.';
            errorMessageModuleContainer.style.color = 'red';
            isValid = false;
        }
        if (TrainingQuiz_EName == "") {
            errorMessageENameContainer.textContent = 'Please Enter English Name.';
            errorMessageENameContainer.style.color = 'red';
            isValid = false;
        }

        if (TrainingQuiz_SName == "") {
            errorMessageSNameContainer.textContent = 'Please Enter Sinhala Name.';
            errorMessageSNameContainer.style.color = 'red';
            isValid = false;
        }
        if (TrainingQuiz_TName == "") {
            errorMessageTNameContainer.textContent = 'Please Enter Tamil Name.';
            errorMessageTNameContainer.style.color = 'red';
            isValid = false;
        }
        if (TrainingQuiz_NoOfAnswerRequired == "") {
            errorMessageNoReqContainer.textContent = 'Please No of Required Answers.';
            errorMessageNoReqContainer.style.color = 'red';
            isValid = false;
        }
        if (TrainingQuiz_AttemptCount == "") {
            errorMessageAttContainer.textContent = 'Please Enter Attempt Count.';
            errorMessageAttContainer.style.color = 'red';
            isValid = false;
        }

        if (!isValid) {
            event.preventDefault();
            return false;
        }else{
            // Change action dynamically
            form.attr('action', '/Quiz/Create');
            form.submit();
        }
    });
</script>